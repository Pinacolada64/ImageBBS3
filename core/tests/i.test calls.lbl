	&"&{comma}23 Get Character from Modem{f6}":return
	&"&{comma}24 xchrout1"+m$+"{f6}":return
	&"&{comma}25 Sound{f6}":return
	&"&{comma}26 callmod{f6}":return
	&"&{comma}27 Save Variable Pointers{f6}":return
	&"&{comma}28 Restore Variable Pointers{f6}":return
	&"&{comma}29 usevar"+m$+"{f6}":return
{number:3072}
{:display_page_3}
	for n=0 to 9:n%=n+20:&sf$:gosub {:header_page_3}:next:return

{:header_page_4}
