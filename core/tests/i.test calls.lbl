' 3050+31=3081
	a%=3081+n:&,66
	&"&{comma}30 putvar{f6}":return
	&"&{comma}31 zero{f6}":return
	&"&{comma}32 minusone{f6}":return
	&"&{comma}33 getarr{f6}":return
	&"&{comma}34 putarr{f6}":return
	&"&{comma}35 getln{f6}":return
	&"&{comma}36 putln{f6}":return
	&"&{comma}37 trapon{f6}":return
	&"&{comma}38 trapoff{f6}":return
	&"&{comma}39 prtln{f6}":return
{number:3092}
{:display_page_4}
	&"ML Functions{colon}{f6:2}":for n=0 to 9:n%=n+30:&sf$:gosub {:header_page_4}:next:return

{:header_page_5}
{number:3100}
' 3060+41=3101
	a%=3101+n:&,66
	&"&{comma}40 forcegc{f6}":return
	&"&{comma}41 setbaud{f6}":return
	&"&{comma}42 ECS Commands{f6}":return
	&"&{comma}43 chatchk"+m$+"{f6}":return
{number:3112}
{:display_page_5}
	for n=0 to 3:n%=n+40:&sf$:gosub {:header_page_5}:next:return

{:header_page_6}
{number:3120}
' 3070+51=3121 (from {:display_page_6})
' FIXME: {:header_page_6}  sets n to 1-10 for selected item number calcgoto
' FIXME: {:display_page_6} sets n to 51-60
	a%=3121+n:&,66
	&"&{comma}50 outscn"+m$+"{f6}":return
	&"&{comma}51 outmod"+m$+"{f6}":return
	&"&{comma}52 Lightbar Interface{f6}":return
	&"&{comma}53 Logoff"+m$+"{f6}":return
	&"&{comma}54 Text Editor Interface{f6}":return
	&"&{comma}55 output"+m$+"{f6}":return
	&"&{comma}56 chatmode"+m$+"{f6}":return
	&"&{comma}57 relread{f6}":return
	&"&{comma}58 setalarm{f6}":return
	&"&{comma}59 farerr{f6}":return
{number:3132}
{:display_page_6}
' n : loop counter, & call number in {:header_page_6}
' n%: the displayed menu selection number (51-60)
	for n=0 to 9:n%=n+50:&sf$:gosub {:header_page_6}:next:return

{:header_page_7}
{number:3140}
' 3080+61=3141
	a%=3141+n:&,66
	&"&{comma}60 structs (run {quotation}i.test structs{quotation}){f6}":return
	&"&{comma}61 poscrsr{f6}":return
	&"&{comma}62 Set Time{f6}":return
	&"&{comma}63 inline1"+m$+"{f6}":return
	&"&{comma}64 convstr"+m$+"{f6}":return
	&"&{comma}65 convert"+m$+"{f6}":return
	&"&{comma}66 Calculated goto/gosub{f6}":return
	&"&{comma}67 copyrite{f6}":return
	&"&{comma}68 structs (run {quotation}i.test structs{quotation}){f6}":return
	&"&{comma}69 Display String on Console{f6}":return
{number:3152}
{:display_page_7}
	for n=0 to 9:n%=n+60:&sf$:gosub {:header_page_7}:next:return

' TODO: page 8
	&"&{comma}70 Position Terminal Cursor{f6}":return

{nice:10}
' 3150?
{:show_page}
' display menu page 'p' commands
' p=1: 3032, p=2: 3052, p=3: 3072, p=4: 3092, p=5: 3112, p=6: 3132, p=7: 3152
	a%=3012+p*20:&,66,1:&"{f6}[Px) Page 1-8{comma} Q)uit]{f6}"
{:prompt}
' m=0: "main menu" not displayed
	l=0:h=70:m=.:q=1:gosub {:sub.input_range}:on -(an$="" or an$="Q" or tr%<1) -2*(q=1) goto {:quit}, {:show_page}
' Px (switch to Page x) hook:
	if left$(an$,1)<>"P" then {:dispatch}
	an=val(mid$(an$,2,1)):if an>. or an<9 then p=an:goto {:show_page}
	gosub {:sub.out_of_range}:goto {:prompt}
{:dispatch}
' separate input into tens (t) and ones (n) digits:
' an=option # chosen
	an$=mid$(str$(an),2):n=val(right$(an$,1)):t=.:if val(an$)>9 then t=val(left$(an$,1))
' display function name:
' &,66,1 (calcgosub): routines start on 20-line increments for {display_page_<an>} routines
	a%=3020+t*20:if db then:&"[header line] a%{equal}{pound}%a{comma} [item] 10s{colon} an{equal}"+str$(an)+"{comma} 1s{colon} n{equal}{pound}!n{f6}"
	&,66,1

' FIXME: temporary hook:
	if an=23 then gosub {:4350}:goto {:prompt}
	if an=25 then gosub {:4450}:goto {:prompt}
	if an=26 then gosub {:4500}:goto {:prompt}
	if an=65 then gosub {:sub.convert}:goto {:prompt}
	if an=67 then gosub {:sub.copyright}:goto {:prompt}
	if an>15 then:&"& calls 16-70 not finished yet.{f6}":goto {:prompt}
' &,66,1: calcgosub: routines start on 50-line increments
	a%=3200+an*50:&"[& line] a%{equal}{pound}%a{f6}":&,66,1:goto {:prompt}

{:3200} ' &,0: output a$
	gosub {:sub.todo}:return

{:3250} ' &,1,x,y: input an$
' &,1,x,y: x = editor flags, y = password flags (source/swap1.s, inline)

' x: Binary | Decimal | Purpose (if set)
' %00000001 | 1   | allow graphics, color and cursor characters
' %00000010 | 2   | "." or "/" on column one exits input
' %00000100 | 4   | don't show the prompt (p$)
' %00001000 | 8   | allow typing the MCI character (pound)
' %00010000 | 16  | word wrap
' %00100000 | 32  | edit mode (shows w$ to edit)
' %01000000 | 64  | ignore time remaining
' %10000000 | 128 | Delete on column one exits input

' y: Binary | Decimal | Purpose (if set)
' %00000001 | 1   | show the mask character, peek(4850) ($12f2, "X" at
'                   boot), for each character typed
' %00000010 | 2   | no output: nothing typed is shown

' returns an$, and peek(53254) ($d006):
' 0 = normal, 1 = Delete or dot on column one, 2 = chat key, 3 = carrier
' lost or time up

' password input: masked (&,1,0,1) or not echoed at all (&,1,0,2); any
' editor flags (&,1,x,0), with w$ as the text to edit
	l=peek(53252):pl=.:qf=.
{:amp_1_menu}
	&"{f6}Mask character (peek(4850)){colon} "+chr$(peek(4850))+"{f6:2}"
	&"1) &{comma}1{comma}0{comma}1{colon} password{comma} shown masked{f6}"
	&"2) &{comma}1{comma}0{comma}2{colon} password{comma} not shown{f6}"
	&"3) Change the mask character{f6}"
	&"4) Editor flags (&{comma}1{comma}x{comma}0){f6}"
	&"Q) Quit{f6}"
	poke 53252,1:pl=1:p$="Which":&,1,0,0:pl=.:if an$="" or an$="Q" or tr%<1 then poke 53252,l:return
	op=val(an$):if op<1 or op>4 then {:amp_1_menu}
	if op=3 then p$="Mask":&,1,0,0:if an$<>"" then poke 4850,asc(an$)
	if op=3 then {:amp_1_menu}
	if op=4 then {:amp_1_editor}
	poke 53252,15:p$="Password":on op goto {:amp_1_masked},{:amp_1_hidden}
{:amp_1_masked}
	&,1,0,1:goto {:amp_1_result}
{:amp_1_hidden}
	&,1,0,2
{:amp_1_result}
	b=peek(53254):&"{f6}an${equal}{quotation}{pound}v7{quotation}{comma} w${equal}{quotation}{pound}$w{quotation}{comma} peek(53254){equal}{pound}!b{f6}":if qf then {:amp_1_flags}
	goto {:amp_1_menu}

' editor flags: 1-8 toggle a bit (shown On/Off), T tries &,1,x,0 with them
{:amp_1_editor}
	x=.:qf=1:q1$(1)="graphics{comma} color and cursor keys allowed":q1$(2)=". or / on column one exits"
	q1$(3)="no prompt":q1$(4)="the MCI character allowed":q1$(5)="word wrap: a word typed past the end goes to w$"
	q1$(6)="edit mode: w$ shown to edit":q1$(7)="time remaining ignored":q1$(8)="Delete on column one exits"
{:amp_1_flags}
' bit values by doubling: 2^n can come out a hair short, and "and" truncates
	&"{f6}Editor flags{colon} &{comma}1{comma}{pound}!x{comma}0{f6:2}":b=1
' lp=1: word-wrap these lines rather than break words at column 40. With
' lp=1, & ends the line itself (source/strio.s, outstr3), so no {f6} at the end
	for i=1 to 8:lp=1:&"{pound}!i) "+mid$("Off On ",1-4*((x and b)>0),3)+" "+q1$(i):b=b*2:next
	lp=1:&"{f6}T) Try it{f6}N) Try it with no time left (tr%{equal}0{colon} bit 7 decides){f6}Return) Back"
	poke 53252,1:pl=1:p$="Toggle":&,1,0,0:pl=.:if an$="" or tr%<1 then qf=.:goto {:amp_1_menu}
	if an$="T" then w$="Edit me":poke 53252,30:p$="Input":&,1,x,0:goto {:amp_1_result}
' &,1 checks the time left by reading tr% (gettsr, source/irqhn.s): save it,
' set it to 0 for the input, then put it back
	if an$="N" then q2%=tr%:tr%=.:w$="Edit me":poke 53252,30:p$="Input":&,1,x,0:tr%=q2%:goto {:amp_1_result}
	i=val(an$):if i<1 or i>8 then {:amp_1_flags}
' a for loop always runs once, even "for j=2 to 1", so only loop for i>1
	b=1:if i>1 then for j=2 to i:b=b*2:next
	if x and b then x=x-b:goto {:amp_1_flags}
	x=x+b:goto {:amp_1_flags}

