	&"&{comma}10 Terminal Mode{f6}":return
	&"&{comma}11 Clear Array{f6}":return
	&"&{comma}12 New User{f6}":return
	&"&{comma}13 arbit{f6}":return
	&"&{comma}14 Dump Array{f6}":return
	&"&{comma}15 Convert an${f6}":return
	&"&{comma}16 sys 49152"+m$+"{f6}":return
	&"&{comma}17 sys 49155"+m$+"{f6}":return
	&"&{comma}18 Set Screen Mode{f6}":return
' TODO: call &,5 routine to save RAM
	&"&{comma}19 Get Version{f6}":return
{number:3052}
{:display_page_2}
