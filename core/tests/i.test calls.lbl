{:4450} ' &,25: Sound
' &,25,<sound>,<repeat> (source/swap2.s, sound; repeats in irqhn.s)
' <sound> = 0-3: beep, ding, higher ding, CCGMS gong; 255: stop repeating
' <repeat> = 0: play once; 1-254: play it repeat+1 times; 255: forever
' While a sound repeats, another &,25 (except 255) is ignored. Sound 0 is
' silent if lightbar flag 27 (local beeps disabled) is on.
	l=peek(53252):&,52,27,3:if a% then:&"{f6}Lightbar 27 (beeps disabled) is on{colon} sound 0 is silent.{f6}"
{:amp_25_menu}
	&"{f6}0-3) Play sound 0-3 once (&{comma}25{comma}x{comma}0){f6}R) Repeat a sound{f6}"
	&"F) Forever (&{comma}25{comma}x{comma}255){f6}S) Stop (&{comma}25{comma}255){f6}Q) Quit{f6}"
	poke 53252,1:pl=1:p$="Sound":&,1,0,0:pl=.:if an$="" or an$="Q" or tr%<1 then:&,25,255:poke 53252,l:return
	if an$="S" then:&,25,255:goto {:amp_25_menu}
	if an$>="0" and an$<="3" then s=val(an$):&,25,s,0:goto {:amp_25_menu}
	if an$<>"R" and an$<>"F" then {:amp_25_menu}
	r=255:o$=an$:poke 53252,1:p$="Which sound (0-3)":&,1,0,0:s=val(an$):if an$<"0" or an$>"3" then {:amp_25_menu}
	if o$="R" then poke 53252,3:p$="Repeat (1-254)":&,1,0,0:r=val(an$):if r<1 or r>254 then {:amp_25_menu}
	&,25,s,r:if r<255 then:&"{f6}&{comma}25{comma}{pound}!s{comma}{pound}!r{colon} plays {pound}!r more time(s) after the first.{f6}":goto {:amp_25_menu}
	&"{f6}&{comma}25{comma}{pound}!s{comma}255{colon} repeating. Another &{comma}25 is ignored now{colon}{f6}"
	poke 53252,1:p$="Return plays sound 1":&,1,0,0:&,25,1,0
	p$="Return stops it (&{comma}25{comma}255)":&,1,0,0:&,25,255:goto {:amp_25_menu}

{:4500} ' &,26: ecschk (find record by flags and name)
' &,26,size,count,mask,array%(element),s$
' a%=first record (1-count) whose flag word (bytes 2-3) shares a bit
' with mask, and whose name (bytes 6-13, chr$(0)-padded) matches s$; 0=none
' zt%(7,2): each record zt%(0-7,r) is 8 integers (16 bytes)
' flags in zt%(1,r), name from zt%(3,r); search starts at record 1
	if zt=0 then dim zt%(7,2):zt=1
	zt%(1,1)=1:&,60,0,8,zt%(3,1),"FOO"
	zt%(1,2)=2:&,60,0,8,zt%(3,2),"BAR"
	&"&{comma}26 Find Record by Flags and Name{f6:2}"
	&,26,16,2,2,zt%(0,1),"BAR":&"mask 2{comma} BAR{colon}      {pound}%a (expect 2){f6}"
	&,26,16,2,1,zt%(0,1),"BAR":&"mask 1{comma} BAR{colon}      {pound}%a (expect 0){f6}"
	&,26,16,2,3,zt%(0,1),"FOO":&"mask 3{comma} FOO{colon}      {pound}%a (expect 1){f6}"
	&,26,16,2,3,zt%(0,1),"":&"mask 3{comma} empty{colon}    {pound}%a (expect 0){f6}"
	&,26,16,2,0,zt%(0,1),"BAR":&"mask 0{comma} BAR{colon}      {pound}%a (expect 0){f6}"
' only 8 characters are compared:
	&,26,16,2,3,zt%(0,1),"BARxxxxxZ":&"mask 3{comma} BARxxxxxZ{colon}{pound}%a (expect 0){f6}"
	&,60,0,8,zt%(3,2),"BARxxxxx"
	&,26,16,2,3,zt%(0,1),"BARxxxxxZ":&"mask 3{comma} BARxxxxxZ{colon}{pound}%a (expect 2){f6}"
' bit 15: stored as -32768, passed in mask as 32768:
	zt%(1,2)=-32768:&,26,16,2,32768,zt%(0,1),"BARxxxxx"
	&"mask 32768{colon}       {pound}%a (expect 2){f6}"
	return

