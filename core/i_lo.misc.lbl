' imported from the release disk (MASTER D1 231231.d81), "i/lo.misc" with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

{uses:3_0-preface.lbl}
{alpha:alt}
{crunch:on}

4000 rem +/lo.misc - misc. idle commands
4002 poke 53248,1:on lmgosub 4100,4200,4300:poke 53248,0:return
' 10/13/2026: Set Time uses sub.clocks with the clock saved in e.data record
' 37 (im=0): the hardware clock, or asking by hand if that's what's saved
' (which gives up after 5 minutes without an answer, so the idle screen comes
' back). The release's own clock setter here (4100-4166) only asked by hand,
' and waited for ever.
' 10/14/2026: keep z$ (zs$) across sub.clocks, which sets z$ to the date:
' this module runs through im line 80, which keeps the name of the module to
' go back to (lo.idle) in z$, and loaded "i/<the date>" instead (?load error)
'4100 &"{clear}":im=.:a$="clocks":gosub 74:return
4100 &"{clear}":zs$=z$:im=.:a$="clocks":gosub 74:z$=zs$:return
4200 &"{clear}{f6}System Password{f6:2}[A]ll Calls, [O]ne Call or [N]one? {pound}g1"
4202 if an$="N" then l2=0:&,52,40,0:&"None{f6}"
4203 if an$="N" then:&,69,31,19," None    ",$8 c:an$="Off":goto 4212
4204 if an$="O" then l2=1:&,52,40,1:&"One{f6}"
4205 if an$="O" then:&,69,31,19," One     ",$8 c:goto 4210
4206 if an$="A" then l2=2:&,52,40,1:&"All{f6}"
4207 if an$="A" then:&,69,31,19," All     ",$8 c:goto 4210
4208 return
4210 poke 53252,10:&"{f6}Enter Password: {pound}i1":if an$="" then 4200
4212 gosub 33:l2$=an$:b$=str$(l2)+l2$:x=21:gosub 1:print# 2,b$:close 2
4214 gosub 33:x=21:gosub 1:&,2,2:l2=val(a$):l2$=(mid$(a$,3)):close 2
4216 &,69,5,20,l2$+"        ",$8 c:return
4300 poke 53252,1:&"{clear}[A]ctivity [I]dle or [N]et Log?: {pound}g1"
4301 a$="r":on-(an$="A")-2*(an$="I")-3*(an$="N") goto 4304,4306,4360
4302 &"Done{f6}":return
4304 &"Activity{f6}":gosub 4320:b$="log"+an$:gosub 36:goto 4314
4306 &"Idle{f6:2}":gosub 4320:b$="idle "+an$:gosub 36:if e%then 4316
4308 &"  Time   {$dd} Since Entry  {$dd} Function{f6}{pound}vj"
4310 input# 2,an$,b$,c$,d$:&,15:c%=val(c$):&right$(an$,7)+"M {$dd}{pound}#3{pound}# {pound}%c mins {pound}$b {$dd} {pound}$d{f6}"
4312 on st+1 goto 4310:goto 4318
4314 sh=.:if e%=.then:&,3,2
4316 if e%then:&
4318 close 2:&"{f6:2}{pound}q0Press Any Key: {pound}g1":goto 4300
4320 a$="s.menu 10":dr=1:gosub 14:return
4360 poke 53252,4:gosub 4376:gosub 4362:&"{f6}{rvrs on} Scan Another? {rvrs off}":gosub 96:on agoto 4360:goto 4300
4362 dr=2:a$="nm.log "+an$+",s,r":gosub 4:a%=.:sh=.:if e%then 4374
4364 a%=a%+1:input# 2,a$,b$:&"{f6}{white}#{pound}%a:{rvrs on}{yellow} {pound}$a {rvrs off}{f6}    {green}{$04}"+right$(b$,11)
4366 if len(b$)>11 then:&"{f6} To {green}{$04}"+left$(b$,11)
4368 &"{f6}{white}Files Transferred:":&,3,2:if st=.and sh=.then 4364
4370 close 2
4372 close 2:return
4374 &"{f6:2}{white}No Log Found":goto 4372
4376 &"{clear}{f6}{green}Scan which log?{f6}{white}(Enter ? for list){f6}nm.log {pound}i0":on-(an$="{f2}") goto 4380
4378 return
4380 dr=2:gosub 2:close 1:open 1,dv%,0,"$"+dr$+"nm.log*":&"{f6}{white}":&,8,1:close 1
4382 &"{pound}{back arrow}10{f6}{rvrs on}Any Key{rvrs off}{pound}g1":goto 4376
4397 rem net logs added 211112 x-tec
4398 rem 7-day logs added 181120 x-tec
4399 rem:"i/lo.misc (c)nissa 211112 lh"
