3040 on lm-10 goto 3282,3104,3044,3192
3042 &,18,1:goto 300
3044 &,28,1:n=8:dim m%(16,n)
3046 &,16,.,34,m%(.,1),"A","","Local Info"
3048 &,16,.,34,m%(.,2),"B","","Modem Specs"
