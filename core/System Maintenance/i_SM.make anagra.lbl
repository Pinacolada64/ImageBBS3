' imported from the release disk (MASTER D1 231231.d81), "i/SM.make anagra" with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

{uses:../3_0-preface.lbl}
{alpha:alt}
{crunch:on}

4000 &"{clear}{rvrs on}{gray3}Anagram Maintenance for{f6}{rvrs on}    {f5}i/lo-anagrams{f5}    {f6}{yellow}By:"
4002 &"{f6}{pound}{back arrow}05{rvrs on}Port Commodore{f6}{pound}{back arrow}06{lt. green}{rvrs on}Original   {rvrs off}":goto 4014
4004 dr=3:a$="e.anagram,l,"+chr$(45):goto 4
4006 dr=3:a$="e.anagram":gosub 4:x=1:&,2,2:y=val(a$):on-(e%<>.) goto 4010:return
4008 print# 2,tt$r$"0" r$"0" r$"0":return
4010 &"{f6:2}{lt. red}File Not Found!"
4012 &"{f6:2}{white}{rvrs on}Hit a Key{rvrs off}{lt. blue}: {pound}g1":on flgoto 4000:goto 4014
4014 &"{f6:2}{green}{rvrs on}Options{rvrs off}{white}:{f6:2}{yellow}? - {lt. green}Help Menu{f6}{yellow}1 - {lt. green}Create Word File{f6}{yellow}2 - {lt. green}Add Words"
4016 &"{f6}{yellow}3 - {lt. green}Edit Words{f6}{yellow}4 - {lt. green}List Words{f6}{yellow}5 - {lt. green}Quit{f6:2}{green}{rvrs on}Opt{rvrs off}{white}? {pound}g1{pound}v7{f6}"
4018 if an$="{f2}" then 4104
4020 x=val(an$):if x<1 or x>5 then 4014
4022 on xgoto 4024,4064,4028,4082,4117:goto 4014
4024 &"{clear}{cyan}{rvrs on}Create Word File!{f6:2}{lt. blue}Continue{white}? ":gosub 94:if a=.then 4014
' 10/14/2026: gosub 1, not "gosub ub1" (which BASIC runs as gosub 0: im line 0
' jumps away, usually to the main prompt, so no records were written)
4026 gosub 4004:for x=1 to 20:gosub 1:print# 2,"{^}":next:close 2:&"{f6:2}{lt. green}Created{yellow}!!":goto 4012
4028 &"{clear}{purple}{yellow}Edit Words.{f6:2}":gosub 4006:x=y+1:if y=.then y=1
4030 if x=.then:&"{f6:2}{yellow}No Words!!":goto 4012
4032 &"{f6}{lt. green}No. {green}Word           {gray3}Used    {white}Right{f6}{pound}{back arrow}26 {lt. red}1st {lt. blue}2nd"
4034 for x=2 to y+1:gosub 1:input# 2,tt$,a%,c%,d%
4036 b%=x-1:if a%>10 then if c%>=10 then gosub 4044:goto 4046
4038 if a%>=10 then gosub 4042:goto 4046
4040 &"{f6}{lt. green}{pound}%b{pound}{back arrow}04{green}":&tt$:&"{pound}{back arrow}19{white}{pound}%a       {lt. red}{pound}%c   {lt. blue}{pound}%d":goto 4046
4042 &"{f6}{lt. green}{pound}%b{pound}{back arrow}04{green}":&tt$:&"{pound}{back arrow}19{white}{pound}%a      {lt. red}{pound}%c   {lt. blue}{pound}%d":return
4044 &"{f6}{lt. green}{pound}%b{pound}{back arrow}04{green}":&tt$:&"{pound}{back arrow}19{white}{pound}%a      {lt. red}{pound}%c  {lt. blue}{pound}%d":return
4046 next:&"{f6:2}{lt. green}Edit Which No.? {pound}i1":on tr%+1 goto 4117:b=val(an$):if an$="" then 4012
4048 x=b+1:if b<1 or b>ythen:&"{f6:2}{yellow}Not Acceptable.":goto 4032
4050 gosub 1:&,2,2:nn$=a$:&"{f6:2}{green}Change {lt. green}{pound}$a? ":gosub 94:if a=.then 4032
4052 &"{f6:2}{gray3}Input New Word: {pound}i1":tt$=an$:on tr%+1 goto 4117
4054 &"{f6:2}{yellow}Old Word: {gray3}":&nn$:&"{f6}New Word: {yellow}":&tt$:&"{f6:2}{green}Correct{white}? ":gosub 94
4056 if a=.then:&"{f6:2}{lt. red}Aborted!":goto 4012
4058 gosub 1:gosub 4008:&"{f6:2}{lt. green}Change Complete. {green}Another{white}? ":gosub 94
4060 if a=.then close 2:goto 4014
4062 goto 4032
4064 &"{clear}{gray3}{rvrs on}Add Words{rvrs off}{white}!{f6:2}":gosub 4006:c=y:d=y:x=y+1:if y=.then y=1
4066 &"{f6}{white}Input Word{f6}{gray3}<{white}{rvrs on}RETURN{rvrs off}{gray3}> {white}to End: {pound}i1":on tr%+1 goto 4117
4068 if an$="" then if c=dthen 4074
4070 if an$="" then 4080
4072 x=x+1:c=c+1:tt$=an$:goto 4076
4074 &"{f6:2}No Words Added.":goto 4012
4076 &"{f6:2}Add This Word? ":&tt$:&": ":gosub 94:on a+1 goto 4064:gosub 1:gosub 4008
4078 goto 4066
4080 z=x-1:x=1:gosub 1:print# 2,z:close 2:&"{f6:2}{gray3}{rvrs on}Word{rvrs off}{white}({rvrs on}{gray3}s{rvrs off}{white}) {gray3}{rvrs on}Added{rvrs off}{white}!":goto 4012
4082 &"{clear}{lt. green}{rvrs on}List Words.{f6:2}"
4084 gosub 4006:if y=.then:&"{f6:2}{yellow}No Words In List.":goto 4012
4086 b%=y:&"{f6:2}{pound}%b Words In List."
4088 &"{f6}{green}No. {lt. green}Word           {cyan}Used   {gray3}Right{f6}{pound}{back arrow}26{white}1st {yellow}2nd"
4090 for x=2 to y+1:gosub 1:input# 2,tt$,a%,c%,d%
4092 b%=x-1:if a%>10 then if c%>=10 then gosub 4100:goto 4098
4094 if a%>=10 then gosub 4102:goto 4098
4096 &"{f6}{lt. green}{pound}%b{pound}{back arrow}04{green}":&tt$:&"{pound}{back arrow}19{yellow}{pound}%a      {white}{pound}%c   {cyan}{pound}%d"
4098 next:&"{f6:2}{yellow}{rvrs on}Listing Complete{rvrs off}{white}! ":goto 4012
4100 &"{f6}{lt. green}{pound}%b{pound}{back arrow}04{green}":&tt$:&"{pound}{back arrow}19{gray3}{pound}%a     {yellow}{pound}%c  {lt. blue}{pound}%d":return
4102 &"{f6}{lt. green}{pound}%b{pound}{back arrow}04{green}":&tt$:&"{pound}{back arrow}19{lt. red}{pound}%a     {cyan}{pound}%c   {gray3}{pound}%d":return
4104 fl=.:&"{clear}      {rvrs on}{yellow}          Help Menu          {rvrs off}"
4106 &"{f6}{lt. blue}                {$b7:4} {$b7:4}{f6:2}  {lt. green}Use Each Option In The Order Listed."
4108 &"{f6:2}  You MUST Create The File FIRST And{f6:2}  Then ADD The Words You Would "
4110 &"Like To{f6:2}  Have Your Users Attempt To Decipher.{f6:2}  One FEATURE That Isn't"
4112 &" Documented{f6:2}  In The {f5}+.on.anagram{f5} File Is"
4114 &"{f6:2}  The Ability To Get The CORRECT Answer{f6:2}  By Putting A ? At The Prompt"
4116 &" In{f6:2}  The Anagram File - Only On The First{f6:2}  Attempt!":fl=1:goto 4012
4117 return
