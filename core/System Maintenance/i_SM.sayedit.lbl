' imported from the release disk (MASTER D1 231231.d81), "i/SM.sayedit" with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

{uses:../3_0-preface.lbl}
{alpha:alt}
{crunch:on}

4000 goto 4010
4002 gosub 1:for i=1 to 4:input# 2,tt$(i):next:return
4004 x=1:gosub 1:print# 2,a1:return
4006 gosub 1:print# 2,tt$(1) r$tt$(2) r$tt$(3) r$tt$(4):return
4008 for i=1 to 4:a%=i:b$=tt$(i):&"{rvrs on}{white}{pound}%a{pound}q0{pound}$b{f6}":next:return
4010 sh=.:dr=3:a$="e.say":gosub 4
4012 x=1:gosub 1:input# 2,a1:&"{clear}{f6:2} * SAYADD *{f6}"
4014 &"{f6}{white} [L]ist{f6} [A]dd{f6} [R]eplace{f6} [D]elete{f6} [E]dit{f6} [Q]uit{f6}"
4016 a%=a1:&"{f6}({pound}%a Current Sayings){pound}q0{f6:2}Sayadd: {pound}i1"
4018 if an$="Q" or an$="" then 4100
4020 if an$="R" then 4060
4022 on-(an$="L")-(an$="A")*2-(an$="D")*3-(an$="E")*4 goto 4028,4024,4070,4080:goto 4014
4024 gosub 4036:if tr%<1 then 4100
4026 a1=a1+1:gosub 4004:x=a1+1:gosub 4006:goto 4014
4028 &"{f6:2}List Starting From Which Saying?{f6:2} : {pound}i1":x=int(val(an$))+1
4030 sh=.:if x<2 or x>a1+1 then 4014
4032 for x=xto a1+1:a%=x-1:&"{f6}Saying#{pound}%a{f6}":if rcthen x=a1+1
4034 gosub 4002:gosub 4008:next:goto 4014
4036 poke 53252,1:&"{f6:2}Enter Left Border Character: {pound}i0"
4038 kk$=an$:if kk$="" then kk$=" "
4040 &"{f6}Enter Right Border Character: {pound}i0":nn$=an$
4042 nn$=an$:if nn$="" then nn$=" "
4044 poke 53252,34:for i=1 to 4:a%=i:&"{f6}Enter Line#{pound}%a{f6}: {pound}i0"
4046 if tr%<1 then i=4
4048 if an$="" then tt$(i)="":next:goto 4052
4050 tt$(i)=" "+an$+" ":next
4052 if tr%<1 then return
4054 for i=1 to 4:a2=len(tt$(i)):a3=-(a2/2<>int(a2/2)):a4=(38-a2-a3)/2
4056 for j=1 to a4:tt$(i)=kk$+tt$(i)+nn$:next:if a3then tt$(i)=kk$+tt$(i)
4058 next:return
4060 &"{f6:2}Replace Which Saying?: {pound}i1":x=val(an$):if x<1 or x>a1+1 then 4014
4062 if tr%<1 then 4100
4064 x=x+1:gosub 4002:gosub 4008
4066 &"{f6:2}Replace?: ":gosub 94:if a=.then 4060
4068 gosub 4036:gosub 4006:goto 4014
4070 &"{f6:2}Delete Which Saying?: {pound}i1":x=int(val(an$)):if x<1 or x>a1+1 then 4014
4072 if tr%<1 then 4100
4074 x=x+1:gosub 4002:gosub 4008
4076 &"{f6:2}Delete?: ":gosub 94:if a=.then 4070
4078 b=x:x=a1+1:gosub 4002:x=b:gosub 4006:a1=a1-1:gosub 4004:goto 4014
4080 &"{f6:2}Edit Which Saying?: {pound}i1":x=int(val(an$)):if x<1 or x>a1+1 then 4014
4082 if tr%<1 then 4100
4084 x=x+1:gosub 4002
4086 gosub 4008:&"{f6:2}Line# To Edit? (RETURN If OK){f6}: {pound}i1":if tr%<1 then 4100
4088 if an$="" then gosub 4006:goto 4014
4090 a=val(an$):if a<1 or a>4 then 4014
4092 pl=.:poke 53252,38:w$=tt$(a):p$="{f6}Enter New Line. (Use 38 Characters){f6:2}"
4094 &,1,32:if tr%<1 then 4100
4096 if len(an$)<>38 then 4092
4098 tt$(a)=an$:goto 4086
4100 close 2:return
4102 rem:"i/SM.sayedit (c)nissa 190124 lh"
