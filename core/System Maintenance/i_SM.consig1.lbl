4008 if x%(2,i)<0 then x%(2,i)=0
4009 x%(0,i)=abs((x%(0,i)) or not 7)-1
4010 &,60,0,30,x%(3,i),a$:next:close 2
4011 dr=3:gosub 3:a$="e.Siglist":print# 15,"s" dr$a$:close 15:dr=3:gosub 3
