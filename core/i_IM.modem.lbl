4092 a%=val(mid$(mt$,1,1)):if a%=0 then:&"{f6} {yellow}- {lt. blue}No Modem Configured.":goto 4104
4094 a$="e0v0":if mid$(mt$,7,1)="H" then a$=a$+"h":if mid$(mt$,6,1)="0" then a$=a$+"0"
4096 a$=a$+"x"+mid$(mt$,8,1)+"b"+mid$(mt$,10,1)
4098 a=49:if mid$(mt$,3,1)<>"A" then a=48
4100 b$="s0="+chr$(a)+"s2=27s7=25"
