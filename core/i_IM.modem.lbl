4130 on-(an$="A")-2*(an$="B")-3*(an$="C")-4*(an$="D") goto 4216,4238,4380,4030
4131 if an$="R" and lk%>0 then:&"{gray3} Re-Select{f6}":on jfgosub 4026:&,28,3:goto 4000
4132 an$="X":goto 4124
4134 &" {gray3}(Flag 1){f6:2}{cyan}What is the Max. Connection Rate For{f6}This Modem?{f6}"
4136 &"{yellow}0: {lt. blue}No Modem{f6}{yellow}1: {lt. blue}300 bps{f6}{yellow}2: {lt. blue}1200 bps{f6}{yellow}3: {lt. blue}2400 bps{f6}{yellow}4: {lt. blue}4800 bps"
4138 &"{f6}{yellow}5: {lt. blue}9600 bps{f6}{yellow}6: {lt. blue}19.2 kbps{f6}{yellow}7: {lt. blue}38.4 kbps{f6}"
4140 b$="01234567":goto 4004
4142 &" {gray3}(Flag 2){f6:2}{cyan}Select Hang-Up Method For This Modem:{f6}"
4144 &"{yellow}D: {lt. blue}DTR Hang-Up{f6}{yellow}E: {lt. blue}ESCape Code Hang-Up{f6}":b$="DE":goto 4004
4146 &" {gray3}(Flag 3){f6:2}{cyan}Select Answer Method For This Modem:{f6}"
4148 &"{yellow}A: {lt. blue}Auto-Answer (ATS0=1){f6}{yellow}M: {lt. blue}Manual Answer (ATA){f6}"
4150 b$="AM":goto 4004
4152 &" {gray3}(Flag 4){f6:2}{cyan}Use an ATH After ESCape Codes?{f6}"
4154 &"{yellow}H: {lt. blue}Yes; Use ATH After ESCape Codes{f6}{yellow}N: {lt. blue}No; Not Needed{f6}"
4156 b$="HN":goto 4004
4158 &" {gray3}(Flag 5){f6:2}{cyan}When In Local Mode, Should Phone be:{f6}"
4160 &"{yellow}N: {lt. blue}On The Hook{f6}{yellow}H: {lt. blue}Off The Hook (Busy Signal){f6}"
4162 b$="NH":goto 4004
4164 &" {gray3}(Flag 6){f6:2}{cyan}Does This Modem Need a 0 After ATH?{f6}"
4166 &"{yellow} 0 : {lt. blue}Yes (ATH0){f6}{yellow}{f5} {f5}: {lt. blue}No (ATH){f6}"
4168 b$="0 ":goto 4004
4170 &" {gray3}(Flag 7){f6:2}{cyan}Should ATH be in the Modem Reset/Init{f6}  String?{f6}"
4172 &"{yellow}H: {lt. blue}Yes{f6}{yellow}N: {lt. blue}No{f6}"
4174 b$="HN":goto 4004
4176 &" {gray3}(Flag 8){f6:2}{cyan}Select Value For ATX Setting{f6}{yellow}(1-4)"
4178 b$="1234":goto 4004
4180 &" {gray3}(Flag 9){f6:2}{cyan}Is DTR on This Modem Normal or Reverse?{f6}"
4182 &"{yellow}N: {lt. blue}Normal DTR{f6}{yellow}R: {lt. blue}Reverse DTR{f6}"
4184 b$="NR":goto 4004
4186 &" {gray3}(Flag 10){f6:2}{cyan}Select CCITT or Bell Labs Standard{f6}"
4188 &"{yellow}0: {lt. blue}CCITT (ATB0; International){f6}{yellow}1: {lt. blue}Bell (ATB1; US/Canada){f6}"
4190 b$="01":goto 4004
4192 &" {gray3}(Flag 11){f6:2}{cyan}Select RS232 Interface Type:{f6}"
4194 &"{yellow}0: {lt. blue}Standard (User Port) RS232{f6}{yellow}1: {lt. blue}SwiftLink Cartridge ($de00 Only){f6}"
4196 b$="01":goto 4004
4198 &" {gray3}(Flag 12){f6:2}{cyan}Is Caller ID Available (Both Modem AND{f6}Phone Line){f6}"
4200 &"{yellow}0: {lt. blue}No; Caller ID Not Available{f6}{yellow}1: {lt. blue}Yes; Caller ID is Available{f6}"
4202 b$="01":goto 4004
