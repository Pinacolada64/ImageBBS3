4106 &"{f6} {yellow}B:{lt. blue}Setup/Import Modem Config{f6} {yellow}C:{lt. blue}Customize Current Result Code(s)"
4108 if lk%then:&"{f6} {yellow}R:{lt. blue}Re-Select Port#"
4110 &"{f6} {yellow}X:{lt. blue}Exit Modem Config{f6}{white}-=>"
4112 &"{pound}g1":a=val(an$):on-(tr%<1) goto 999:on a+1 goto 4124,4114:goto 4116
4114 &"{pound}v7{pound}g1":on-(an$=chr$(13)) goto 4116:a=10+val(an$):&mid$(str$(val(an$)),2)
4116 if len(mt$)=1 then:&"{f6:2}{yellow}You Must First Setup a Modem!{f6:2}  {white}>Any Key<{pound}g1":goto 4030
