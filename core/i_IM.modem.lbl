' i/IM.modem: IM modem configuration (flags, init strings, result codes)
' imported from the release disk (MASTER D1 231231.d81), "i/IM.modem" with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

{uses:3_0-preface.lbl}
{alpha:alt}
{crunch:on}

4000 rem modem/rs232 config
4002 &,27,3:dim mr%(15,51)
4003 gosub 4012:goto 4030
4004 &"{white}-=>"
4006 &"{pound}g1":if a$<>"" and an$=chr$(13) then:&"{pound}$a{f6}":return
4008 for i=1 to len(b$):if an$=mid$(b$,i,1) then a$=an$:&"{pound}$a{f6}":i=len(b$)+1:next:return
4010 next:on-(tr%<1) goto 999:goto 4006
4012 jf=.:mt$="0":dr=3:a$="e.i.modem":gosub 4:if e%then gosub 4022
4014 p=.:on 1+lk%goto 4020:p=(peek(57092) and 15):&"{f6:2}{lt. blue}Edit Modem Config for Which"
4016 &" Port?{f6}{yellow}({cyan}RETURN = {pound}!p){white}: {pound}i1"
4018 if (val(an$)>1 and val(an$)<15) or an$="0" then p=val(an$)
4020 x=p+1:gosub 1:&,2,2:mt$=a$:&,2,2:in$=a$:&,2,2:m$=a$:&,2,2:au$=a$
4021 close 2:return
4022 dr=3:gosub 61:gosub 60:if a<>0 or bf<15 then:&"{f6}Disk Full!{pound}w2":return
4023 dr=3:a$="e.i.modem,l,"+chr$(100):gosub 4:x=17::gosub 1:print# 2:gosub 1
4024 for x=1 to 16:gosub 1:print# 2,"0"+r$+"{^}"+r$+"{^}"+r$+"{^}":if lk%=.then x=17
4025 next:return
4026 &"{f6} {cyan}Update Modem Flags?{white}: ":gosub 96:on a+1 goto 999:dr=3:a$="e.i.modem"
4027 gosub 4:x=p+1:gosub 1:print# 2,mt$r$in$r$m$r$au$:close 2
4028 gosub 33:a$=mid$(mt$,11,1):x=32:gosub 1:print# 2,a$:close 2:return
4030 &"{clear}{white}":&"Modem: {gray3}"+m$+"{f6}{white}By   : {gray3}"+au$+"{f6}"
4032 &"{f6}{rvrs on}{cyan} Modem Config Flags ":if lk%then:&"For Port #{pound}!p {rvrs off}"
4034 a%=val(mid$(mt$,1,1)):if a%=0 then:&"{f6} {yellow}- {lt. blue}No Modem Configured.":goto 4090
4036 &"{f6} {yellow}1:{lt. blue}Max. Baud ":&mid$("300 120024004800960019.238.4",(4*a%)-3,4)
4038 if a%>5 then:&"k"
4040 a$="DTR":if mid$(mt$,2,1)="E" then a$="ESC Code"
4042 &"{pound}{back arrow}21{yellow}2:{lt. blue}{pound}$a Hang-Up"
4044 a$="Auto-":if mid$(mt$,3,1)="M" then a$="Manual "
4046 &"{f6} {yellow}3:{lt. blue}{pound}$aAnswer"
4048 &"{pound}{back arrow}21{yellow}4:{lt. blue}":a$="No ":if mid$(mt$,4,1)="H" then a$=""
4050 &"{pound}$aATH Aft/ ESC"
4052 a$="n":if mid$(mt$,5,1)="H" then a$="ff"
4054 &"{f6}{yellow} 5:{lt. blue}Local O{pound}$a Hook"
4056 a$="w/o ":b$="":if mid$(mt$,6,1)="0" then a$="w/":b$="0"
4058 &"{pound}{back arrow}21{yellow}6:{lt. blue}ATH {pound}$a0 (ATH{pound}$b)"
4060 a$="No ":if mid$(mt$,7,1)="H" then a$=""
4062 &"{f6}{yellow} 7:{lt. blue}{pound}$aATH in Init$"
4064 &"{pound}{back arrow}21{yellow}8:{lt. blue}ATX Value = "+mid$(mt$,8,1)
4066 a$="Normal":if mid$(mt$,9,1)="R" then a$="Reversed"
4068 &"{f6}{yellow} 9:{lt. blue}{pound}$a DTR"
4070 a$="CCITT (ATB0)":if mid$(mt$,10,1)="1" then a$="Bell (ATB1)"
4072 &"{pound}{back arrow}20{yellow}10:{lt. blue}{pound}$a"
4074 a$=" Normal":if mid$(mt$,11,1)="1" then a$="SwiftLink"
4076 &"{f6}{yellow}11:{lt. blue}RS232:{pound}$a"
4078 a$="No ":if mid$(mt$,12,1)="1" then a$=""
4080 &"{pound}{back arrow}20{yellow}12:{lt. blue}{pound}$aCaller ID"
