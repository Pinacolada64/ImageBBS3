4958 ifa2=a1thena1=a1+1:ifa1=>a3thena1=2
4960 on-(s=0)goto4954:x=1:gosub1:print#2,a1;r$a2;r$a3:gosub1:close2:goto4928
4962 k=7:gosub4972:ifa=0thenreturn
4964 tt$(i)="":dr=2:a$=o$+",s,r":gosub4:ife%then4970
4966 a$=mid$(o$,10,3):&"{f6}NetWall from {pound}$a":f$="nm.wall":gosub4988:ife%then4970
