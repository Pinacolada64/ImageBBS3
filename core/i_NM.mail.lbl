4940 &,2,2:s=st:print#3,a$:on-(s=.)goto4940
4942 close3:close2:next:dr=2:gosub3:print#15,"s"dr$o$:return
4944 k=8:gosub4972:ifa=0thenreturn
4946 tt$(i)="":dr=2:a$="nm.grf2":gosub4:&,2,2:a1=val(a$):&,2,2:a2=val(a$)
