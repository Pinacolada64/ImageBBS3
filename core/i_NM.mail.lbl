' imported from the release disk (MASTER D1 231231.d81), "i/NM.mail", with:
'   C64List4_04.exe -txt -keycase -varcase -alpha:alt (as tools/detok.sh
'   --keep-spaces), then jumps to lines 3_0-preface.lbl doesn't name written
'   {$3x}nnn so C64List leaves them as they are (detok.sh would write [nnnn]).
'   Unchanged, this builds the release's program byte for byte, except
'   capitals in rem text ($61-$7a).

{uses:3_0-preface.lbl}
{alpha:alt}

4000 rem "+/NM.mail" 05-19-91
4002 r$=chr$(13):gosub4500:gosub4600:gosub4900
4004 return
4500 rem process mail
4501 gosub35:x=1:gosub1:&,2,2:lh$=a$:close2
4502 dr=2:a$="nm.forward":gosub4:ife%then4520
4504 &"Checking Forward List...":x=1:gosub1:&,2,2:n=val(a$):&,2,2
4506 ifn=0then:&"Empty!":goto4520
4508 ifa$=mid$(d1$,2,6)then:&"Already Done!":goto4520
4510 x=1:gosub1:print#2,n;r$mid$(d1$,2,6):close2
4512 forxx=1ton:dr=2:a$="nm.forward":gosub4:ife%then4520
4514 x=xx+1:gosub1:input#2,a1$,a2$,a3$:close2
4516 lp=.:ifa3$<>""thenlp=1:&"{f6}From:"+a1$+"{f6}To:"+a2$+"{f6}Node:"+a3$:gosub4522
4518 next
4520 close2:&"{f6}":return
' 11/10/2026: mail (m.) and waiting-mail (f.) file names keep 14 characters of the
' handle (a 16-character file name), as im line 32 and i/lo.on 4178 do; some
' modules kept 13, so a 14+ character handle's mail went to another file
4522 dr=2:a$="m."+left$(a1$,14)+",s,r":gosub4:close2:ife%thenreturn
4524 f$="nm.M."+a3$+"/"+nn$:dr=2
4526 a$=f$+",s,w":gosub4:ife%thena$=f$+",s,a":gosub4:ife%thenclose2:return
4528 close3:open3,dv%,3,dr$+"m."+left$(a1$,14):lh=1
4530 &".":print#2,a2$:&,2,3:print#2,a$:&,2,3:print#2,0:&,2,3:print#2,a$:&,2,3
4532 ifleft$(a$,1)="!"then4536
4534 a$="!"+left$(str$(nn)+"    ",4)+left$(bn$+"                    ",20)+a$
4536 print#2,a$:print#2,">This Message Was Forwarded From "r$bn$
4538 &,2,3:s=st:print#2,a$:ifa$<>"{^}"then4538
4540 ifs=.thenlh=lh+1:goto4530
4542 close2:close3:b$=a3$+"/"+nn$+"/A/"+f$:gosub{$33}030
4544 print#15,"s"dr$"m."left$(a1$,14)
4546 gosub30:i=-lh:x=25:gosub16:close2
4548 ifa1$=lh$thengosub30:i=-lh:x=24:gosub16:close2
4550 return
4600 a$="path":gosub28:ife%then:&:return
4602 dr=2:gosub3:a$=dr$+"nm.nodelist":&,16:gosub5:ife%then:&:return
4604 g$="nm.M.":dr=2:a$="nm.list,s,r":gosub4:kk=0:ife%thenclose2:goto4618
4606 &,2,2:kk=kk+1:ed$(kk)=a$:on-(st=0andkk<61)goto4606:close2:u=1
4608 o$=mid$(ed$(u),11):ifleft$(o$,8)=g$+nn$thengosub4620:ed$(u)=""
4610 u=u+1:on-(u<=kk)goto4608:x=0:fori=1tokk:ifed$(i)<>""thenx=x+1:ed$(x)=ed$(i)
4612 next:kk=x
4614 dr=2:gosub3:print#15,"s"dr$"nm.list"
4616 ifkkthena$="nm.list,s,w":gosub4:fori=1tokk:print#2,ed$(i):next:close2
4618 return
4620 &"Delivering NetMail{f6}":n=0:a%=0
4622 dr=2:a$=o$+",s,r":gosub4:ife%thenclose2:return
4624 &,2,2:&:b$=a$:n=n+1:nn$(n)=a$:e%(n)=1
