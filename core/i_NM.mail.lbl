4628 ife%thene%(n)=.:close3:open3,dv%,3,dr$+"m."+left$(b$,14)+",s,a"
4630 &,2,2:print#3,a$:&,2,2:print#3,a$:&,2,2:print#3,a$d1$
4632 &,2,2:s=st:print#3,a$:ifa$<>"{^}"ands=.then4632
4634 &"{f6}":on-(s=0)goto4624:close2:close3:print#15,"s"dr$o$:&"Updating Stats{f6}"
4636 forz=1ton:an$=nn$(z):gosub505:ifi=0thengosub4650:goto4644
4638 st(3)=st(3)+1:st(14)=st(14)+1:st(25)=st(25)+1:st(32)=st(32)+1
4640 ifi=1thenst(2)=st(2)+1:st(13)=st(13)+1:st(24)=st(24)+1:st(31)=st(31)+1
4642 rem:st(25)=st(25)+e%(z)
4644 gosub30
4646 x=13:gosub17:x=14:gosub17:x=24:gosub17:x=25:gosub17:x=31:gosub17:x=32:gosub17
4648 next:close2:return
4650 dr=2:a$="nm.nodes":gosub4:ife%thenclose2:return
4652 &,2,2:n=val(a$):a$=nn$(z):&"No User:{pound}$a - Returning{f6}"
4654 close3:open3,dv%,3,dr$+"m."+left$(nn$(z),14)+",s,r"
4656 gosub5:ife%then4680
4658 &,2,3:tt$(1)=a$:&,2,3:&,2,3:tt$(2)=a$:&,2,3:a=val(mid$(a$,2,4))
4660 on-(a<1ora>n)goto4682:x=a+1:gosub1:&,2,2
4662 b$=a$+"/"+nn$:f$="nm.M."+b$:tt$=b$+"/A/"+f$
4664 lp=1:&tt$:f=1:on-(kk=0)goto4668:fori=1tokk:ifed$(i)=tt$thenf=0
4666 next
4668 iffthenkk=kk+1:ed$(kk)=tt$
4670 close2:open2,dv%,2,dr$+f$+",s,w":gosub5
4672 ife%thenclose2:open2,dv%,2,dr$+f$+",s,a":gosub5:ife%thenclose2:goto4682
4674 print#2,tt$(1)r$"NetMail"r$;0;r$d1$r$"[Handle Not Found:"+nn$(z)+"]"
4676 print#2,">This message was returned from "r$bn$r$">On {$04}"d1$
4678 &,2,3:s=st:print#2,a$:on-(a$<>"{^}"ands=0)goto4678:close2:on-(s=0)goto4684
4680 close3:print#15,"s"dr$"m."left$(nn$(z),14):return
4682 &,2,3:s=st:on-(a$<>"{^}"ands=0)goto4682:on-(s<>0)goto4680
4684 close2:open2,dv%,2,dr$+"nm.nodes":goto4658
4686 rem
4900 rem process netwall
